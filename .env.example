# Optional. Without a key, NEUROQUERY runs in offline demo mode (rule-based, sample questions only).
ANTHROPIC_API_KEY=
NEUROQUERY_MODEL=claude-sonnet-5-5
# Force the offline demo engine even if a key is set: demo
NEUROQUERY_ENGINE=
NEUROQUERY_DATA_DIR=./data
NEUROQUERY_MAX_ROWS=500
NEUROQUERY_QUERY_TIMEOUT=3
